rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Public read access for invitation hero images, write for authenticated users
    match /hero_images/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Public read access for background audio tracks, write for authenticated users
    match /audio/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Public read access for invitation gallery photos, write for authenticated users
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
