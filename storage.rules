rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Public read and authenticated write access for invitation media assets
    match /hero_images/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Public read and authenticated write access for background audio tracks
    match /audio/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Public read and authenticated write access for invitation gallery photos
    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
